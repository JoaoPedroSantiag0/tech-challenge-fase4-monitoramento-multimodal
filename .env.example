# Copie para .env e preencha. NUNCA versione o .env.

# Azure AI Speech (Speech to Text) — recurso "Speech" no portal Azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_LANGUAGE=pt-BR

# Azure AI Language (Text Analytics) — recurso "Language" no portal Azure
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/

# (Opcional) Webhook para notificar a equipe (Teams/Slack/Discord) em alertas ALTO/CRITICO
ALERT_WEBHOOK_URL=
